{
  "id": "/nutcade/",
  "name": "NUTCADE",
  "short_name": "NUTCADE",
  "description": "A Bitcoin wallet for Cashu ecash, Lightning and on-chain payments, protected by a 12-word recovery phrase, with ten retro arcade cabinets built in. It works offline and has no account and no tracking.",
